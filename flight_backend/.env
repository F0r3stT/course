# Основные настройки
APP_ENV=dev
PORT=8080

# База данных PostgreSQL
DATABASE_URL=postgres://flights_user:password@localhost:5432/flights

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-123

# Настройки безопасности
LOGIN_RATE_RPS=3.0
LOGIN_BURST=10

# CORS
CORS_ORIGIN=http://localhost:5173
